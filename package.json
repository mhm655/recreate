{
  "name": "ts-sandbox-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Two-layer sandbox (gVisor container + worker thread) for executing untrusted TypeScript functions against a fixed test-input list.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/index.js",
  "bin": {
    "tsbox": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:unit": "npm run build && node --test dist/test/encoding.test.js dist/test/import-guard.test.js",
    "test:hostile": "npm run build && node --test dist/test/hostile-pipeline.test.js",
    "image": "docker build -f docker/Dockerfile -t ts-sandbox-harness:latest .",
    "check:host": "bash scripts/check-sandbox.sh",
    "tsbox": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.2",
    "lodash-es": "^4.18.1",
    "ms": "^2.1.3",
    "typescript": "^5.6.3",
    "zod": "^4.6.5"
  }
}
